    <string name="goal_surgical_planning_title">Planification chirurgicale</string>
    <string name="goal_surgical_planning_sub">Optimiser les incisions cutanées</string>
    <string name="goal_surgical_planning_desc">Identifier les lignes de tension pour orienter les incisions afin de réduire la traction sur les tissus et améliorer la cicatrisation.</string>
    <string name="goal_scar_minimization_title">Minimiser les cicatrices</string>
    <string name="goal_scar_minimization_sub">Réduire la visibilité des cicatrices post-opératoires</string>
    <string name="goal_scar_minimization_desc">Utiliser les lignes de Langer pour orienter les sutures afin que la cicatrice S\'intègre à la tension naturelle de la peau.</string>
