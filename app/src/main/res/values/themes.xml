<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LangerLines" parent="Theme.Material3.Light.NoActionBar">
        <!-- Colore primario visto dal sistema (splash, recents, widget) -->
        <item name="colorPrimary">@color/brand_primary</item>

        <!-- Barre di sistema trasparenti: Compose le gestisce con enableEdgeToEdge() -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Sfondo splash/avvio uguale al background light di Compose -->
        <item name="android:windowBackground">@color/background_light</item>

        <!-- Disabilita l'animazione di avvio legacy (usiamo SplashScreen API se serve) -->
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Linee_Langer" parent="Base.Theme.LangerLines" />

</resources>